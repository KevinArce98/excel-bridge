{
  "name": "excel-bridge",
  "version": "1.4.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "description": "A lightweight, modular Excel manipulation library based on micro-packages",
  "keywords": [
    "excel",
    "xlsx",
    "spreadsheet",
    "xlsx-parser",
    "xlsx-writer",
    "excel-reader",
    "excel-writer",
    "office-open-xml",
    "ooxml",
    "typescript",
    "browser",
    "nodejs",
    "tree-shakeable",
    "lightweight",
    "exceljs-alternative",
    "sheetjs-alternative"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "bench": "pnpm run build && node benchmarks/bench.mjs",
    "size": "pnpm run build && node benchmarks/size.mjs",
    "size:check": "node benchmarks/size.mjs --check",
    "check:package": "publint --strict && attw --pack .",
    "smoke:pack": "node scripts/smoke-pack.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinArce98/excel-bridge.git"
  },
  "author": "Kevin Arias",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KevinArce98/excel-bridge/issues"
  },
  "homepage": "https://kevinarce98.github.io/excel-bridge/"
}
